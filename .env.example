TZ=Asia/Shanghai

MINDORA_VM_HOST=192.168.222.128
MINDORA_DEPLOY_ROOT=/data/proj/MindOra
MINDORA_DOCKER_DATA_ROOT=/data/docker-data/mindora

MYSQL_HOST=192.168.222.128
MYSQL_PORT=3306
MYSQL_DATABASE=mindora
MYSQL_USER=mindora
MYSQL_PASSWORD=mindora_password
MYSQL_ROOT_PASSWORD=mindora_root_password

REDIS_HOST=192.168.222.128
REDIS_PORT=6379
REDIS_PASSWORD=

QDRANT_HOST=192.168.222.128
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://192.168.222.128:6333
QDRANT_COLLECTION=mindora_chunks

ROCKETMQ_NAMESRV_HOST=192.168.222.128
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_NAMESRV_ADDR=192.168.222.128:9876
ROCKETMQ_BROKER_IP=192.168.222.128
ROCKETMQ_BROKER_LISTEN_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_PRODUCER_GROUP=mindora-stage0-producer

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_MINDORA=DEBUG
JWT_SECRET=change-me-to-a-long-random-stage0-secret
MINDORA_STORAGE_ROOT=/data/docker-data/mindora/storage
MINDORA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
